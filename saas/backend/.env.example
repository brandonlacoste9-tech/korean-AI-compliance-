# ========================================
# Korean AI Compliance SaaS - Backend Environment Variables
# ========================================
# Copy this file to .env and fill in your actual values
# 이 파일을 .env로 복사하고 실제 값을 입력하세요
#
# Korean AI Basic Act Compliance Deadline: January 22, 2026 (77 days remaining)
# 한국 AI 기본법 준수 마감일: 2026년 1월 22일 (77일 남음)
# ========================================

# ----------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------
# PostgreSQL connection string (Railway auto-generates this when you add PostgreSQL)
# Railway에서 PostgreSQL을 추가하면 자동으로 생성됩니다
DATABASE_URL=postgresql://user:password@host:5432/dbname

# For local development with SQLite:
# DATABASE_URL=sqlite:///./compliance.db

# ----------------------------------------
# STRIPE PAYMENT CONFIGURATION
# ----------------------------------------
# Get your keys from: https://dashboard.stripe.com/test/apikeys
# Test mode keys (for development):
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY

# Live mode keys (for production - DO NOT commit to git):
# STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
# STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY

# Stripe Webhook Secret (from https://dashboard.stripe.com/webhooks)
# Required for verifying webhook signatures
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Korean Payment Methods (enabled through Stripe dashboard)
# 한국 결제 수단 (Stripe 대시보드에서 활성화)
# - kr_card: Korean credit/debit cards with installment support
# - kakao_pay: Kakao Pay (requires business verification)
# - naver_pay: Naver Pay (requires business verification)

# ----------------------------------------
# EMAIL SERVICE CONFIGURATION (RESEND)
# ----------------------------------------
# Get your API key from: https://resend.com/api-keys
# Test key (for development):
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_API_KEY

# Live key (for production):
# RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_LIVE_KEY

# Verified domain for sending emails (required for production)
# FROM_EMAIL=noreply@aicomplianceguardian.com

# ----------------------------------------
# SECURITY & AUTHENTICATION
# ----------------------------------------
# Generate a random secret key for JWT tokens:
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_random_secret_key_here_change_this_in_production

# Allowed CORS origins (comma-separated)
# For local development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# For production:
# ALLOWED_ORIGINS=https://aicomplianceguardian.com,https://www.aicomplianceguardian.com

# ----------------------------------------
# FEATURE FLAGS
# ----------------------------------------
# Enable/disable Stripe live mode (set to true for production)
ENABLE_STRIPE_LIVE=false

# Enable/disable email notifications
SEND_EMAIL_NOTIFICATIONS=false

# Enable/disable AI chat features
ENABLE_AI_CHAT=true

# ----------------------------------------
# KOREAN AI BASIC ACT COMPLIANCE
# ----------------------------------------
# PIPC (Personal Information Protection Commission) Compliance
# 개인정보보호위원회 규정 준수
PIPC_COMPLIANCE_MODE=strict

# AI Basic Act - High-impact system registration
# Article 31: All high-risk AI systems must be registered
# 제31조: 모든 고위험 AI 시스템은 등록되어야 합니다
AI_SYSTEM_REGISTRATION_REQUIRED=true

# Article 32: Risk management plan required for high-risk systems
# 제32조: 고위험 시스템은 위험 관리 계획이 필요합니다
RISK_MANAGEMENT_ENABLED=true

# Article 33: Pre-deployment review required
# 제33조: 배포 전 검토 필요
PRE_DEPLOYMENT_REVIEW_REQUIRED=true

# ----------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------
# Environment (development, staging, production)
PYTHON_ENV=development

# Server port (Railway will set this automatically)
PORT=8000

# API version
API_VERSION=v1

# ----------------------------------------
# LOGGING & MONITORING
# ----------------------------------------
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx

# ----------------------------------------
# KOREAN MARKET SPECIFIC
# ----------------------------------------
# Default currency for pricing
DEFAULT_CURRENCY=KRW

# Default language (ko, en)
DEFAULT_LANGUAGE=ko

# Timezone (Asia/Seoul for Korea)
TZ=Asia/Seoul

# Business registration number (사업자등록번호) - required for Korean invoices
# BUSINESS_REGISTRATION_NUMBER=xxx-xx-xxxxx

# ----------------------------------------
# COMPLIANCE DEADLINE REMINDERS
# ----------------------------------------
# AI Basic Act full enforcement date: January 22, 2026
COMPLIANCE_DEADLINE=2026-01-22

# Send deadline reminders at these milestones (days)
REMINDER_MILESTONES=180,90,60,30,14,7,3,1

# ----------------------------------------
# RATE LIMITING (for production)
# ----------------------------------------
# Requests per minute per IP
RATE_LIMIT_PER_MINUTE=60

# Maximum email sends per day per user
EMAIL_LIMIT_PER_DAY=100

# ----------------------------------------
# NOTES FOR DEPLOYMENT
# ----------------------------------------
# Railway Deployment:
# 1. Add PostgreSQL database in Railway dashboard
# 2. Railway will auto-inject DATABASE_URL
# 3. Add all other variables manually in Railway dashboard
# 4. Use "Secret" visibility for sensitive values
#
# Render Deployment:
# 1. Go to Dashboard → Environment
# 2. Add each variable individually
# 3. Mark sensitive values as "Secret"
#
# Security Best Practices:
# - Never commit .env files to git
# - Rotate secrets regularly (every 90 days)
# - Use different keys for test/live environments
# - Monitor Stripe dashboard for suspicious activity
# - Enable 2FA on all service accounts
#
# Korean AI Basic Act Articles Reference:
# - Article 31: AI system registration and notification
# - Article 32: Risk management for high-risk systems
# - Article 33: Pre-deployment conformity assessment
# - Article 34: Post-deployment monitoring
# - Article 36: Incident response and reporting
# - Article 40: Penalties (up to ₩30,000,000 for violations)
#
# Compliance Resources:
# - MSIT (Ministry of Science and ICT): https://www.msit.go.kr
# - PIPC: https://www.pipc.go.kr
# - Korea AI Law Portal: https://law.go.kr
