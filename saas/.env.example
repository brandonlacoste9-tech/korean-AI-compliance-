# ========================================
# Korean AI Compliance SaaS - Frontend Environment Variables
# ========================================
# Copy this file to .env.local and fill in your actual values
# 이 파일을 .env.local로 복사하고 실제 값을 입력하세요
#
# Next.js automatically loads .env.local (not committed to git)
# Next.js는 자동으로 .env.local을 로드합니다 (git에 커밋되지 않음)
# ========================================

# ----------------------------------------
# BACKEND API CONFIGURATION
# ----------------------------------------
# Backend API base URL
# For local development (when running backend on localhost:8000):
NEXT_PUBLIC_API_URL=http://localhost:8000

# For production (after deploying backend to Railway):
# NEXT_PUBLIC_API_URL=https://your-backend-name.railway.app

# API version
NEXT_PUBLIC_API_VERSION=v1

# ----------------------------------------
# STRIPE PAYMENT CONFIGURATION
# ----------------------------------------
# Stripe Publishable Key (safe to expose in browser)
# Get from: https://dashboard.stripe.com/test/apikeys

# Test mode (for development):
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY

# Live mode (for production):
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY

# Stripe Secret Key (NEVER expose to browser - only used in API routes)
# Used for creating checkout sessions in /app/api/create-checkout-session/route.ts
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY

# For production:
# STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY

# ----------------------------------------
# STRIPE PRODUCT PRICING
# ----------------------------------------
# Stripe Price IDs for subscription plans
# Create these in Stripe Dashboard → Products → Add Product
#
# After creating products in Stripe, get the price IDs and add them here:

# Starter Plan (₩130,000/month or $99/month)
NEXT_PUBLIC_STRIPE_PRICE_ID_STARTER_KRW=price_REPLACE_WITH_STARTER_KRW_PRICE_ID
NEXT_PUBLIC_STRIPE_PRICE_ID_STARTER_USD=price_REPLACE_WITH_STARTER_USD_PRICE_ID

# Professional Plan (₩390,000/month or $299/month)
NEXT_PUBLIC_STRIPE_PRICE_ID_PROFESSIONAL_KRW=price_REPLACE_WITH_PROFESSIONAL_KRW_PRICE_ID
NEXT_PUBLIC_STRIPE_PRICE_ID_PROFESSIONAL_USD=price_REPLACE_WITH_PROFESSIONAL_USD_PRICE_ID

# Enterprise Plan (Custom pricing - contact sales)
# No price ID needed - handled separately

# ----------------------------------------
# EMAIL SERVICE (RESEND)
# ----------------------------------------
# Only needed if sending emails from frontend API routes
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_API_KEY

# ----------------------------------------
# FEATURE FLAGS
# ----------------------------------------
# Enable/disable features in production

# Enable Korean payment methods (Kakao Pay, Naver Pay)
# Note: Requires Stripe business verification in Korea
NEXT_PUBLIC_ENABLE_KOREAN_PAYMENTS=true

# Enable installment payments (할부)
NEXT_PUBLIC_ENABLE_INSTALLMENTS=true

# Enable AI chat widget
NEXT_PUBLIC_ENABLE_CHAT_WIDGET=true

# Enable risk assessment tool
NEXT_PUBLIC_ENABLE_RISK_ASSESSMENT=true

# ----------------------------------------
# KOREAN MARKET CONFIGURATION
# ----------------------------------------
# Default currency (KRW or USD)
NEXT_PUBLIC_DEFAULT_CURRENCY=KRW

# Default language (ko or en)
NEXT_PUBLIC_DEFAULT_LANGUAGE=ko

# Available currencies (comma-separated)
NEXT_PUBLIC_AVAILABLE_CURRENCIES=KRW,USD

# Available installment terms (comma-separated, in months)
NEXT_PUBLIC_INSTALLMENT_TERMS=3,6,12

# ----------------------------------------
# COMPLIANCE INFORMATION
# ----------------------------------------
# AI Basic Act compliance deadline: January 22, 2026
NEXT_PUBLIC_COMPLIANCE_DEADLINE=2026-01-22

# Days remaining until deadline (auto-calculated in app)
# This is displayed in the UI to create urgency

# ----------------------------------------
# ANALYTICS & TRACKING (Optional)
# ----------------------------------------
# Google Analytics 4
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-REPLACE_WITH_YOUR_GA_ID

# Facebook Pixel
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=REPLACE_WITH_YOUR_FACEBOOK_PIXEL_ID

# Kakao Analytics (for Korean market)
# NEXT_PUBLIC_KAKAO_ANALYTICS_ID=REPLACE_WITH_YOUR_KAKAO_ID

# Naver Analytics (for Korean market)
# NEXT_PUBLIC_NAVER_ANALYTICS_ID=REPLACE_WITH_YOUR_NAVER_ID

# ----------------------------------------
# SEO & SOCIAL METADATA
# ----------------------------------------
# Site URL (for canonical links and social sharing)
NEXT_PUBLIC_SITE_URL=https://aicomplianceguardian.com

# Default Open Graph image
NEXT_PUBLIC_OG_IMAGE=https://aicomplianceguardian.com/og-image.jpg

# Twitter/X handle
NEXT_PUBLIC_TWITTER_HANDLE=@AIComplianceKR

# ----------------------------------------
# SUPPORT & CONTACT
# ----------------------------------------
# Support email
NEXT_PUBLIC_SUPPORT_EMAIL=support@aicomplianceguardian.com

# Sales email
NEXT_PUBLIC_SALES_EMAIL=sales@aicomplianceguardian.com

# Phone (Korean format)
NEXT_PUBLIC_SUPPORT_PHONE=+82-2-xxxx-xxxx

# Business address (Korean)
NEXT_PUBLIC_BUSINESS_ADDRESS=서울특별시 강남구 테헤란로 xxx

# ----------------------------------------
# DEVELOPMENT CONFIGURATION
# ----------------------------------------
# Next.js development server port (default: 3000)
# PORT=3000

# Enable Next.js debug mode
# DEBUG=true

# Disable telemetry (optional)
# NEXT_TELEMETRY_DISABLED=1

# ----------------------------------------
# NOTES FOR DEPLOYMENT
# ----------------------------------------
# Vercel Deployment:
# 1. Go to Vercel dashboard → New Project
# 2. Import from GitHub
# 3. Set Root Directory to "saas" (or wherever package.json is)
# 4. Add all NEXT_PUBLIC_* variables in Environment Variables section
# 5. Add STRIPE_SECRET_KEY and RESEND_API_KEY as secrets
# 6. Deploy
#
# Environment Variable Visibility:
# - NEXT_PUBLIC_* variables are exposed to the browser (safe for public data)
# - Other variables (like STRIPE_SECRET_KEY) are only available server-side
#
# Security Best Practices:
# - Never commit .env.local to git
# - Use different Stripe keys for test/live
# - Rotate API keys every 90 days
# - Monitor Stripe webhook logs for issues
#
# Korean AI Basic Act Compliance:
# - Display compliance deadline countdown (77 days remaining)
# - Show high-risk system warnings in Korean
# - Provide links to MSIT and PIPC resources
# - Include privacy policy in Korean (PIPC requirements)
# - Display business registration number on invoices
#
# Korean Market Localization:
# - All prices must show both KRW and USD
# - Enable installment payments (3, 6, 12 months)
# - Support Kakao Pay and Naver Pay (pending Stripe verification)
# - Use formal Korean (존댓말) in all customer communications
# - Include compliance articles (제31조-제40조) in documentation
#
# Performance Optimization:
# - Use Next.js Image Optimization for faster loads
# - Enable ISR (Incremental Static Regeneration) for pricing pages
# - Use CDN for static assets (Vercel provides this automatically)
# - Implement caching for API responses
#
# Testing:
# - Test checkout flow with Stripe test cards
# - Verify email sending with test email addresses
# - Test risk assessment calculations
# - Verify Korean language displays correctly
# - Test installment payment options
#
# Resources:
# - Stripe Docs: https://stripe.com/docs
# - Next.js Docs: https://nextjs.org/docs
# - Vercel Deployment: https://vercel.com/docs
# - Korean AI Basic Act: https://law.go.kr
