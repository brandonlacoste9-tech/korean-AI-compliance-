# Base URL for the backend compliance API (match deployment origin or local dev server)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe publishable key for client-side checkout flows (Stripe Dashboard > Developers > API Keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_change_me

# Stripe price identifier for the subscription plan shown in the app
NEXT_PUBLIC_STRIPE_PRICE_ID=price_professional_plan_krw

# xAI API Key for Grok integration (Get from https://console.x.ai/)
XAI_API_KEY=your_xai_api_key_here

# Google Analytics Measurement ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Environment (development | production)
NEXT_PUBLIC_ENVIRONMENT=development
