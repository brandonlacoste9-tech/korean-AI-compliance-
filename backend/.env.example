# PostgreSQL connection string for compliance data storage (Supabase Seoul region recommended)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost/dbname

# Stripe secret key for billing automation (Stripe Dashboard > Developers > API Keys)
STRIPE_SECRET_KEY=sk_test_change_me

# Stripe webhook signing secret (Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_change_me

# Frontend URL for Stripe success/cancel redirects (e.g., https://korean-ai-compliance.vercel.app)
FRONTEND_URL=http://localhost:3000

# Resend API key for transactional email delivery (Resend Dashboard > API Keys)
RESEND_API_KEY=re_test_change_me

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000

# Toggle live Stripe mode (set to true only after production readiness review)
ENABLE_STRIPE_LIVE=false

# Enable compliance notifications via email (set to true to dispatch alerts through Resend)
SEND_EMAIL_NOTIFICATIONS=true

# JWT signing secret for API authentication (generate using: openssl rand -hex 32)
JWT_SECRET=please_replace_with_secure_value

# Environment (development | production)
ENVIRONMENT=development

# Log level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
