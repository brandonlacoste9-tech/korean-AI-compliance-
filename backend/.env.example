# PostgreSQL connection string for compliance data storage (obtain from your DB provider)
DATABASE_URL=postgresql://user:password@localhost/dbname

# Stripe secret key for billing automation (create in Stripe Dashboard > Developers > API Keys)
STRIPE_SECRET_KEY=sk_test_change_me

# Resend API key for transactional email delivery (Resend Dashboard > API Keys)
RESEND_API_KEY=re_test_change_me

# Comma-separated list of allowed origins for CORS (e.g., https://app.example.com,https://admin.example.com)
ALLOWED_ORIGINS=http://localhost:3000

# Toggle live Stripe mode (set to true only after production readiness review)
ENABLE_STRIPE_LIVE=false

# Enable compliance notifications via email (set to true to dispatch alerts through Resend)
SEND_EMAIL_NOTIFICATIONS=true

# JWT signing secret for API authentication (generate using a secure random string)
JWT_SECRET=please_replace_with_secure_value
